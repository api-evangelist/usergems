          "name": "Delete Account",
          "request": {
            "name": "Delete Account",
            "description": {
              "content": "Remove a previously added account. Identified by (name, domain); the\noptional reportName, signal, salesforceId, and customId fields scope the\ndeletion to a specific routing context.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "account"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) Account name as previously submitted."
                },
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "(Required) Primary domain for the account."
                },
                {
                  "disabled": false,
                  "key": "reportName",
                  "value": "<string>",
                  "description": "Report or workflow grouping the account belongs to."
                },
                {
                  "disabled": false,
                  "key": "signal",
                  "value": "<string>",
                  "description": "Signal label originally attached to the account."
                },
                {
                  "disabled": false,
                  "key": "salesforceId",
                  "value": "<string>",
                  "description": "Salesforce Account ID for cross-reference."
                },
                {
                  "disabled": false,
                  "key": "customId",
                  "value": "<string>",
                  "description": "Customer-supplied identifier for cross-reference."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
