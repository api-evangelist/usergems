              ],
              "path": [
                "account"
              ],
              "query": [
                {
                  "description": "(Required) Account name as previously submitted.",
                  "key": "name",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Primary domain for the account.",
                  "key": "domain",
                  "value": "<string>"
                },
                {
