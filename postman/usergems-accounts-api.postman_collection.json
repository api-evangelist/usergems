                  "value": "<string>"
                },
                {
                  "description": "Customer-supplied identifier for cross-reference.",
                  "key": "customId",
                  "value": "<string>"
                }
              ]
            },
            "description": "Remove a previously added account. Identified by (name, domain); the\noptional reportName, signal, salesforceId, and customId fields scope the\ndeletion to a specific routing context.\n"
