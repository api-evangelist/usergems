{
  "info": {
    "_postman_id": "77259982-0a64-4918-9ca4-683e5a387253",
    "name": "UserGems Accounts API",
    "description": "The UserGems API lets customers programmatically add contacts to track for job\nchanges and add accounts to receive prospects for. It also exposes a privacy\ndelete endpoint used to honor data-subject removal requests. Requests are\nauthenticated with a customer-issued API key sent in the X-Api-Key header and\nare processed asynchronously \u2014 responses confirm enqueueing, not completion.\n\n\nContact Support:\n Name: UserGems\n Email: support@usergems.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:25:53.000Z",
    "updatedAt": "2026-07-28T03:25:53.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-77259982-0a64-4918-9ca4-683e5a387253"
  },
